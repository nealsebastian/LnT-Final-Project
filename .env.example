PORT=5000
NODE_ENV=development
# Replace with your MongoDB connection string (e.g. mongodb://localhost:27017/ecommerce_db or Atlas URI)
# If left blank, the app will automatically start an in-memory MongoDB instance for zero-setup demo!
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db
JWT_SECRET=supersecretjwtkey_p01_ecommerce_2026_secure
JWT_EXPIRES_IN=7d
# Auto seed sample users, categories, products, orders on startup if collections are empty
AUTO_SEED=true
